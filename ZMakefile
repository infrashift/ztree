# ztree development gates with zmake `@name:` tasks. The Makefile has the same targets.
# `@name:` declares each task, so this file has no .PHONY list.
# zmake reads this file before the Makefile. GNU Make reads the Makefile.

ZIG ?= zig
PYTHON ?= python3
GO ?= go
GOFMT ?= $(shell $(GO) env GOROOT)/bin/gofmt
ZIG_SOURCES := build.zig build.zig.zon src tests tools
# lexiscope checks the documentation with vocabulary.cue when it is on the PATH (ADR-0018).
LEXISCOPE ?= lexiscope
# The docs-lexiscope task reads these files with the vocabulary of this repository.
# Each finding fails it.
DOCS_LEXISCOPE_PATHS := CLAUDE.md PLAN.md .okfw
DOCS_LEXISCOPE_FLAGS := --ruleset ste-100 --ruleset vocabulary.cue --fail-on note \
	--exclude .okfw/daily --exclude .okfw/ephemeral --exclude index.md --exclude log.md

## check: run every gate (the default goal)
@check: lint test conformance differential query-diff go wiki docs-style docs-lexiscope

## build: compile the library into zig-out
@build:
    $(ZIG) build

## lib: write the static library and the C header to zig-out (ReleaseSafe)
@lib:
    $(ZIG) build lib --release

## go: check the format of the Go binding, vet it and test it with the race detector
@go: lib
    $(GOFMT) -l bindings/go | (! grep .)
    cd bindings/go && $(GO) vet ./...
    cd bindings/go && $(GO) test -race -count=1 ./...

## test: run the unit tests
@test:
    $(ZIG) build test --summary all

## conformance: check each grammar corpus example against its expected tree
@conformance:
    $(ZIG) build conformance --summary all

## differential: parse the source files of this repository with ztree and the reference runtime
@differential:
    $(ZIG) build differential --summary all

## query-diff: compare the query matches with the reference query cursor
@query-diff:
    $(ZIG) build query-diff --summary all

## lint: check the formatting and the Power of 10 rules
@lint:
    $(ZIG) fmt --check $(ZIG_SOURCES)
    $(PYTHON) -I scripts/nasa-lint.py

## fmt: format the Zig sources in place
@fmt:
    $(ZIG) fmt $(ZIG_SOURCES)

## wiki: validate the OKF wiki
@wiki:
    okfw validate --all
    okfw validate --okf

## docs-style: check the documentation against ASD-STE100 rules
@docs-style:
    $(PYTHON) -I scripts/ste-check.py

## docs-lexiscope: check the documentation with lexiscope and vocabulary.cue, when lexiscope is on the PATH (each finding fails)
@docs-lexiscope:
    if command -v $(LEXISCOPE) >/dev/null 2>&1; then $(LEXISCOPE) scan $(DOCS_LEXISCOPE_FLAGS) $(DOCS_LEXISCOPE_PATHS); else echo "docs-lexiscope: $(LEXISCOPE) not found, so scripts/ste-check.py checks the documentation alone"; fi
